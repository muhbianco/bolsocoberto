ENVIRONMENT=development
LOG_LEVEL=INFO
DOCS_ENABLED=true

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=bolsocoberto
DB_PASSWORD=
DB_NAME=bolsocoberto
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

SESSION_SECRET=troque-por-pelo-menos-32-caracteres-aleatorios
PUBLIC_URL=http://127.0.0.1:8000
OAUTH_ALLOWLIST=muhbianco@gmail.com

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GEMINI_API_KEY=
LLM_MODEL=gemini-3.5-flash
# Teto da API Gemini 3.5 Flash. Valores maiores são ignorados pelo modelo.
LLM_MAX_OUTPUT_TOKENS=65536
LLM_TIMEOUT_SECONDS=300
# Contenção máxima de 8-gramas contra as fontes antes de bloquear a publicação.
SIMILARITY_BLOCK_THRESHOLD=0.12

WP_BASE_URL=https://bolsocoberto.com.br
WP_APP_USER=
WP_APP_PASSWORD=
# id do usuário que assina os posts; 0 mantém o autor da Application Password.
WP_AUTHOR_ID=0
WP_INDEX_TTL_MINUTES=60

# Séries públicas do Banco Central (SGS). Sem chave.
BCB_API_BASE=https://api.bcb.gov.br
BCB_TIMEOUT_SECONDS=10
HERO_IMAGE_ENABLED=true
